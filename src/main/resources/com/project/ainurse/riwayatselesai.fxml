<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="768.0" prefWidth="1366.0" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.ainurse.controller.riwayatselesaicontroller">


    <left>
        <fx:include source="sidebar.fxml" />
    </left>


    <center>
        <VBox spacing="20.0" BorderPane.alignment="CENTER">
            <padding><Insets bottom="20.0" left="30.0" right="30.0" top="20.0" /></padding>
            <children>


                <BorderPane>
                    <left>
                        <Label text="Rekapitulasi Pasien Selesai" textFill="#2C3E50">
                            <font><Font name="System Bold" size="28.0" /></font>
                        </Label>
                    </left>
                    <right>
                        <Label fx:id="lblNamaPerawat" text="👤 Perawat" textFill="#2C3E50">
                            <font><Font name="System Bold" size="16.0" /></font>
                        </Label>
                    </right>
                </BorderPane>


                <TableView fx:id="tabelRiwayat" VBox.vgrow="ALWAYS" style="-fx-background-color: rgba(255, 255, 255, 0.45); -fx-background-radius: 15; -fx-border-color: rgba(255, 255, 255, 0.8); -fx-border-width: 2; -fx-border-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                    <columns>
                        <TableColumn fx:id="colRm" prefWidth="80.0" text="No. RM" />
                        <TableColumn fx:id="colNama" prefWidth="150.0" text="Nama Pasien" />
                        <TableColumn fx:id="colUsia" prefWidth="60.0" text="Usia" />
                        <TableColumn fx:id="colSuhu" prefWidth="60.0" text="Suhu" />
                        <TableColumn fx:id="colKeluhan" prefWidth="300.0" text="Keluhan..." />
                        <TableColumn fx:id="colTriase" prefWidth="250.0" text="Hasil Triase" />
                        <TableColumn fx:id="colStatus" prefWidth="150.0" text="Status" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

            </children>
        </VBox>
    </center>
</BorderPane>
