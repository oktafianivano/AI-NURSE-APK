<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<StackPane style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.ainurse.controller.formdaftarcontroller">
    <children>
        <Pane maxHeight="500.0" maxWidth="500.0" prefHeight="500.0" prefWidth="500.0" style="-fx-background-color: rgba(255, 255, 255, 0.45); -fx-background-radius: 15; -fx-border-color: rgba(255, 255, 255, 0.8); -fx-border-width: 2; -fx-border-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
            <children>
                <Label layoutX="70.0" layoutY="40.0" text="📝 FORM REGISTRASI MANDIRI" textFill="#d81b60">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
                <Label layoutX="80.0" layoutY="80.0" text="Mohon isi data diri dan keluhan Anda dengan jelas." textFill="GRAY">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>

                <TextField fx:id="txtNama" layoutX="40.0" layoutY="130.0" prefHeight="45.0" prefWidth="420.0" promptText="👤 Nama Lengkap Anda..." style="-fx-background-color: #F4F6F9; -fx-background-radius: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 10;" />
                <TextField fx:id="txtUsia" layoutX="40.0" layoutY="190.0" prefHeight="45.0" prefWidth="420.0" promptText="📅 Usia Anda (Tahun)..." style="-fx-background-color: #F4F6F9; -fx-background-radius: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 10;" />

                <Label layoutX="45.0" layoutY="250.0" text="Detail Keluhan Penyakit:">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Label>
                <TextArea fx:id="txtKeluhan" layoutX="40.0" layoutY="270.0" prefHeight="100.0" prefWidth="420.0" promptText="Ketik keluhan di sini..." style="-fx-control-inner-background: #F4F6F9; -fx-background-radius: 10;" wrapText="true" />

                <Label fx:id="lblNotif" alignment="CENTER" layoutX="40.0" layoutY="380.0" prefWidth="420.0" textFill="#00cc66">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>

                <Button layoutX="40.0" layoutY="420.0" mnemonicParsing="false" onAction="#kembaliKeMenu" prefHeight="45.0" prefWidth="120.0" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-background-radius: 10;" text="← Kembali">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>
                <Button layoutX="175.0" layoutY="420.0" mnemonicParsing="false" onAction="#prosesDaftar" prefHeight="45.0" prefWidth="285.0" style="-fx-background-color: #d81b60; -fx-text-fill: white; -fx-background-radius: 10;" text="KIRIM &amp; DAFTAR 🚀">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>
            </children>
        </Pane>
    </children>
</StackPane>
